# Neon Postgres connection string (pgvector is enabled by `pnpm db:push`)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenRouter — tutor LLM (anthropic/claude-opus-5) + embeddings
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: talk to Anthropic directly instead of via OpenRouter
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables Whisper STT + OpenAI TTS (otherwise browser speech APIs are used)
# OPENAI_API_KEY=sk-...
